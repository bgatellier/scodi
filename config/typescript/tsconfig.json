{
  "extends": "tsconfig-moon/tsconfig.json",

  "compilerOptions": {
    // Disable error reporting for unreachable code.
    "allowUnreachableCode": false,
    // Disable error reporting for unused labels.
    "allowUnusedLabels": false,
    // Raise an error when a function parameter isn't read.
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    // Explicit because tsgo does not auto-include @types/bun under bun's
    // isolated node_modules (@types/bun only references bun-types).
    // "node" must stay listed: "types" replaces auto-inclusion entirely.
    "types": ["node", "bun"],
    "module": "nodenext",
    "moduleResolution": "nodenext"
  }
}